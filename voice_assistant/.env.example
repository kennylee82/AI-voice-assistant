# Required for live voice mode
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Model identifiers can be changed independently of the code.
OPENAI_MODEL=gpt-4o
# Eleven v4 Turbo uses the Text-to-Dialogue WebSocket.
ELEVENLABS_TTS_MODEL_ID=eleven_v4_turbo

# Optional integrations. HubSpot stays mocked unless explicitly disabled.
HUBSPOT_MOCK=true
HUBSPOT_ACCESS_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALL_SID=
TWILIO_FROM_NUMBER=
HANDOFF_NUMBER=

# Local audio (device IDs can be listed with sounddevice.query_devices())
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_MS=20
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
BARGE_IN_RMS_THRESHOLD=0.035
RAG_TOP_K=3
